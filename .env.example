# Copy this file to `.env` (same folder) and fill it in. `.env` is git-ignored and never baked into the image.
# Then run: docker compose up -d --build

# Optional: lets Claude draft SUGGESTED challenges from your video transcripts (you approve each one).
# Create a key at https://console.anthropic.com/ -> API keys, and set a monthly spend limit there.
# Only transcript text is sent; videos and audio never leave this PC.
ANTHROPIC_API_KEY=

# Optional: model to use. Default is claude-opus-5-5. claude-haiku-5-5 is far cheaper and fine for short transcripts.
# ANTHROPIC_MODEL=claude-haiku-5-5

# Optional: where uploads and transcripts are stored (default ./media-library)
# MEDIA_DIR=D:/motivati-media
